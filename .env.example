# ==============================================================================
# SILVER SCOUT ENTERPRISE PRODUCTION CONFIGURATION (.env.example)
# ==============================================================================
# Copy this file to .env and populate the required environment variables.
# In Docker deployments, these variables can be passed via docker-compose.yml or Docker secrets.

# ------------------------------------------------------------------------------
# 1. APPLICATION RUNTIME & CONTROL PLANE SERVER
# ------------------------------------------------------------------------------
PORT=3001
NODE_ENV=production
DATA_DIR=/app/data
APP_URL=https://app.silverscout.ai

# ------------------------------------------------------------------------------
# 2. GOOGLE GEMINI AI ENGINE
# ------------------------------------------------------------------------------
# Required for IC Memo generation, intent routing, financial doc parsing, and agentic sweeper
GEMINI_API_KEY=your_gemini_api_key_here
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 3. FIREBASE CLIENT AUTHENTICATION & MULTI-TENANT FIRESTORE
# ------------------------------------------------------------------------------
# Required for multi-tenant user authentication and real-time deal sync
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# ------------------------------------------------------------------------------
# 4. STRIPE ENTERPRISE BILLING & MONETIZATION
# ------------------------------------------------------------------------------
# Required for multi-tier SaaS subscriptions (Starter, Growth, Institutional)
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here
STRIPE_PRICE_ID_STARTER=price_starter_monthly_799
STRIPE_PRICE_ID_GROWTH=price_growth_monthly_2499
STRIPE_PRICE_ID_INSTITUTIONAL=price_institutional_monthly_6999

# ------------------------------------------------------------------------------
# 5. SENDGRID OUTREACH & WEBHOOK EVENT STREAM
# ------------------------------------------------------------------------------
# Required for direct founder cold email cadences and inbound engagement telemetry
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_WEBHOOK_SECRET=your_sendgrid_webhook_hmac_signing_secret
SENDGRID_FROM_EMAIL=deals@silverscout.ai

# ------------------------------------------------------------------------------
# 6. HUBSPOT CRM SYNCHRONIZATION
# ------------------------------------------------------------------------------
# Required for bi-directional pipeline sync and deal stage webhooks
HUBSPOT_ACCESS_TOKEN=your_hubspot_access_token_here
HUBSPOT_WEBHOOK_SECRET=your_hubspot_webhook_signature_secret

# ------------------------------------------------------------------------------
# 7. SALESFORCE AGENTFORCE & DATA CLOUD INTEGRATION
# ------------------------------------------------------------------------------
# Required for Zero-Copy Data Cloud DMO ingestion and Agentforce Invocable Actions
SALESFORCE_INSTANCE_URL=https://your-org.my.salesforce.com
SALESFORCE_CLIENT_ID=your_salesforce_client_id_here
SALESFORCE_CLIENT_SECRET=your_salesforce_client_secret_here
SALESFORCE_WEBHOOK_SECRET=your_salesforce_flow_hmac_secret

# ------------------------------------------------------------------------------
# 8. CISO ZERO-TRUST & RATE LIMITING
# ------------------------------------------------------------------------------
# Optional overrides for security enforcement
CISO_JWT_SECRET=your_enterprise_jwt_signing_key_32_chars_min
ADMIN_API_KEY=your_admin_secret_key_for_dlq_replay
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

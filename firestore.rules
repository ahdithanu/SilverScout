rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // CISO ZERO-TRUST TENANT ISOLATION & RBAC RULES
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserFundId() {
      return 'fundId' in request.auth.token 
        ? request.auth.token.fundId 
        : getUserData().fundId;
    }

    function getUserRole() {
      return 'role' in request.auth.token 
        ? request.auth.token.role 
        : getUserData().role;
    }

    function isFundMember(fundId) {
      return isAuthenticated() && getUserFundId() == fundId;
    }

    function isFundAdmin(fundId) {
      return isFundMember(fundId) && (
        getUserRole() == 'admin' || 
        getUserRole() == 'partner'
      );
    }

    // ===============================================================
    // Collection Scopes
    // ===============================================================

    // Users Collection (Strict Tenant Isolation)
    match /users/{userId} {
      allow read: if isAuthenticated() && (
        isOwner(userId) || 
        isFundMember(resource.data.fundId)
      );
      allow create: if isAuthenticated() && isOwner(userId);
      allow update: if isAuthenticated() && (
        isOwner(userId) || 
        isFundAdmin(resource.data.fundId)
      );
      allow delete: if false; // Deny hard deletes; use soft archiving
    }

    // Leads Collection (Strict Multi-Tenant Scoping)
    match /leads/{leadId} {
      // Must belong to user's authorized fund
      allow read: if isAuthenticated() && (
        resource == null || 
        isFundMember(resource.data.fundId)
      );
      allow create: if isAuthenticated() && 
        request.resource.data.fundId != null && 
        isFundMember(request.resource.data.fundId);
      allow update: if isAuthenticated() && 
        isFundMember(resource.data.fundId) && 
        request.resource.data.fundId == resource.data.fundId; // Prevent tenant reparenting
      allow delete: if isAuthenticated() && 
        isFundMember(resource.data.fundId) && 
        isFundAdmin(resource.data.fundId);
    }

    // Multi-Tenant Funds Root & Subcollections
    match /funds/{fundId} {
      allow read: if isFundMember(fundId);
      allow write: if isFundAdmin(fundId);

      // Fund Deployment & Underwriting Configurations
      match /config/{configId} {
        allow read: if isFundMember(fundId);
        allow write: if isFundAdmin(fundId);
      }

      // Fund Deals Subcollection
      match /deals/{dealId} {
        allow read: if isFundMember(fundId);
        allow create, update: if isFundMember(fundId);
        allow delete: if isFundAdmin(fundId);

        // Immutable Cryptographic Audit & Execution Provenance Ledger
        match /executionRecords/{recordId} {
          allow read: if isFundMember(fundId);
          allow create: if isFundMember(fundId);
          allow update, delete: if false; // Strict WORM (Write Once, Read Many)
        }
      }

      // Transactional Outbox Subcollection
      match /outbox/{outboxId} {
        allow read: if isFundMember(fundId);
        allow create, update: if isFundMember(fundId);
        allow delete: if isFundAdmin(fundId);
      }
    }

    // Global Catch-All Deny
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
